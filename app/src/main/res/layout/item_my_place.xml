<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Row: Place Name + Status Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvPlaceName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Place Name"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="To Visit"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Location Breakdown Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F7FA"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvPlaceState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="State: —"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-monospace" />

                <TextView
                    android:id="@+id/tvPlaceCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="City / Town: —"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvPlaceVillage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Village / Area: —"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-monospace"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeletePlace"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Delete"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleVisited"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Mark Visited"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/purple_primary"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
