<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Tourist Place (India)"
            android:textColor="@color/purple_dark"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search any Indian tourist spot, city, town, or village to auto-fill its location."
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <!-- Search Box + Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etSearchPlace"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="e.g., Hampi, Tirupati, Ooty..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchIndia"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Search"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSearch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:layout_marginVertical="8dp"
            android:visibility="gone" />

        <!-- Dynamic Search Results Container -->
        <LinearLayout
            android:id="@+id/llSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginVertical="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Place Details (Auto-filled or Manual)"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPlaceName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="Tourist Place Name *"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPlaceState"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="State (e.g., Maharashtra)"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPlaceCity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="City / Town / District"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPlaceVillage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:hint="Village / Area"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbAlreadyVisited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark as already visited"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
